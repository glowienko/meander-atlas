{
  "name": "meander-atlas-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:comments": "node --test scripts/check-no-comments.test.mjs && node scripts/check-no-comments.mjs",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "check:fast": "pnpm run lint && pnpm run check:comments && pnpm run typecheck && pnpm run test",
    "check:all": "pnpm run gen:api && pnpm run lint && pnpm run check:comments && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "lucide-react": "1.78.0",
    "maplibre-gl": "6.19.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
