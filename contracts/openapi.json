      "get" : {
        "operationId" : "regionTile",
        "parameters" : [ {
          "in" : "path",
          "name" : "level",
          "required" : true,
          "schema" : {
            "type" : "string",
            "enum" : [ "COUNTRY", "ADMIN1" ]
