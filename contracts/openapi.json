        }, {
          "in" : "path",
          "name" : "z",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "in" : "path",
          "name" : "x",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "in" : "path",
          "name" : "y",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "in" : "query",
          "name" : "countryCode",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ]
          }
