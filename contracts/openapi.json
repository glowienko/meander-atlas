        "responses" : {
          "200" : {
            "content" : {
              "application/vnd.mapbox-vector-tile" : {
                "schema" : {
                  "type" : "string",
                  "format" : "binary"
                }
              }
            },
            "description" : "Mapbox Vector Tile payload"
          },
          "204" : {
            "description" : "No features in requested tile"
